{
  "name": "@onborn/runtime-expo-ui-ir",
  "version": "0.5.1-beta.1",
  "description": "Expo host for verified Onborn UI IR artifacts.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "check-types": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "node --import tsx --test src/**/*.test.ts",
    "prepack": "yarn build"
  },
  "dependencies": {
    "@onborn/runtime-ui-ir": "0.5.1-beta.1",
    "@onborn/sdk-contracts": "0.6.1-beta.1",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "expo-file-system": ">=57.0.0",
    "react": ">=18.0.0",
    "react-native": ">=0.86.0",
    "expo-font": ">=57.0.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "eslint": "^9.39.1",
    "expo-file-system": "~57.0.0",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "tsx": "^4.21.0",
    "typescript": "5.9.2",
    "expo-font": "~57.0.1"
  }
}
